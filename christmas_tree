i=1
while i<=5:
   spaces = ' ' *(5-i)
   stars=  '*' * ( 2*i-1)
   if i==1:
      print("\033[31m",spaces +stars,"\033[0m")
   else:
      print("\033[32m",spaces +stars,"\033[0m")
   i+=1
